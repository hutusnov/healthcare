aws_region = "ap-southeast-2"

# Staging is intended for a separate AWS account/region.
# Copy this file to terraform.tfvars and replace every REPLACE_* value.
# Do not commit terraform.tfvars.
vpc_id                   = "vpc-REPLACE_WITH_STAGING_VPC_ID"
public_subnet_1_id       = "subnet-REPLACE_WITH_STAGING_PUBLIC_A_ID"
public_subnet_1_cidr     = "10.20.0.0/20"
public_subnet_1_az       = "ap-southeast-2a"
public_subnet_2_id       = "subnet-REPLACE_WITH_STAGING_PUBLIC_B_ID"
public_subnet_2_cidr     = "10.20.16.0/20"
public_subnet_2_az       = "ap-southeast-2b"
private_subnet_1_id      = "subnet-REPLACE_WITH_STAGING_PRIVATE_A_ID"
private_subnet_1_cidr    = "10.20.128.0/20"
private_subnet_1_az      = "ap-southeast-2a"
private_subnet_2_id      = "subnet-REPLACE_WITH_STAGING_PRIVATE_B_ID"
private_subnet_2_cidr    = "10.20.144.0/20"
private_subnet_2_az      = "ap-southeast-2b"
igw_id                   = "igw-REPLACE_WITH_STAGING_IGW_ID"
nat_gateway_id           = "nat-REPLACE_WITH_STAGING_NAT_ID"
nat_eip_allocation_id    = "eipalloc-REPLACE_WITH_STAGING_NAT_EIP_ID"
public_route_table_id    = "rtb-REPLACE_WITH_STAGING_PUBLIC_RTB_ID"
private_route_table_1_id = "rtb-REPLACE_WITH_STAGING_PRIVATE_A_RTB_ID"
private_route_table_2_id = "rtb-REPLACE_WITH_STAGING_PRIVATE_B_RTB_ID"
public_rtb_assoc_1_id    = "rtbassoc-REPLACE_WITH_STAGING_PUBLIC_A_ASSOC_ID"
public_rtb_assoc_2_id    = "rtbassoc-REPLACE_WITH_STAGING_PUBLIC_B_ASSOC_ID"
private_rtb_assoc_1_id   = "rtbassoc-REPLACE_WITH_STAGING_PRIVATE_A_ASSOC_ID"
private_rtb_assoc_2_id   = "rtbassoc-REPLACE_WITH_STAGING_PRIVATE_B_ASSOC_ID"

backend_subnet_id        = "subnet-REPLACE_WITH_STAGING_PRIVATE_A_ID"
backend_instance_type    = "t3.micro"
backend_ami_id           = "ami-REPLACE_WITH_UBUNTU_2404_AMI_AP_SOUTHEAST_2"
key_name                 = "healthcare-staging-key"
create_backend_instance  = false
backend_sg_name          = "healthcare-staging-backend-sg"
backend_sg_description   = "Staging backend security group managed by Terraform"
backend_instance_name    = "healthcare-staging-backend"
backend_ingress_cidrs    = ["10.20.0.0/16"]
adopt_existing_sg_safely = true
manage_alb_sg            = true
alb_sg_name              = "healthcare-staging-alb-sg"
alb_sg_description       = "Staging ALB security group"
manage_vpn_sg            = true
vpn_sg_name              = "healthcare-staging-vpn-sg"
vpn_sg_description       = "Staging VPN security group"

alb_name                  = "healthcare-staging-alb"
target_group_name         = "healthcare-staging-tg"
target_group_port         = 4000
target_group_protocol     = "HTTP"
health_check_path         = "/api/health"
http_listener_port        = 80
https_listener_port       = 443
https_certificate_arn     = "arn:aws:acm:ap-southeast-2:REPLACE_ACCOUNT_ID:certificate/REPLACE_CERTIFICATE_ID"
https_ssl_policy          = "ELBSecurityPolicy-TLS13-1-2-2021-06"
https_fixed_response_body = "Forbidden: Direct access is not allowed"
target_instance_ids       = []

alarm_prefix        = "uit-healthcare-staging"
alarm_sns_topic_arn = ""

github_owner             = "hutusnov"
github_repo              = "healthcare"
github_actions_role_name = "GitHubActionsHealthcareStagingDeployRole"
allowed_workflow_refs = [
  "hutusnov/healthcare/.github/workflows/pipeline-unified.yml@refs/heads/main",
  "hutusnov/healthcare/.github/workflows/cd-backend.yml@refs/heads/main",
  "hutusnov/healthcare/.github/workflows/cd-frontend.yml@refs/heads/main",
  "hutusnov/healthcare/.github/workflows/gitops-promote-image.yml@refs/heads/main"
]

common_tags = {
  Project     = "uit-healthcare"
  Environment = "staging"
  Env         = "staging"
  Managed     = "terraform"
}

# Safety override: keep false until the staging AWS IDs are confirmed.
# Set true only after checking that no dev/prod/shared IDs remain.
allow_nondev_plan_with_shared_ids = false

aws_region   = "ap-southeast-2"
project_name = "uit-healthcare"
environment  = "staging"

vpc_cidr            = "10.30.0.0/16"
public_subnet_cidrs = ["10.30.0.0/24", "10.30.1.0/24"]

# Replace with your current public IP /32 before apply.
admin_ssh_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

# Recommended for a clean AWS account.
create_key_pair = true
key_name        = "healthcare-staging-key"
ssh_public_key  = "ssh-ed25519 REPLACE_WITH_PUBLIC_KEY_ONLY"

backend_count         = 2
backend_instance_type = "t3.micro"

# ALB has hourly cost. Keep true for full staging; set false for cheapest SSH-only reproduce.
create_alb = true

# Enable only after ACM cert is issued in ap-southeast-2.
enable_https_listener = false
acm_certificate_arn   = ""

# Secret metadata is managed by Terraform. Secret values are inserted with AWS CLI
# or Ansible and must not be put into terraform.tfvars/state.
secret_recovery_window_in_days = 0

common_tags = {
  Project     = "uit-healthcare"
  Environment = "staging"
  Env         = "staging"
  Managed     = "terraform"
}
